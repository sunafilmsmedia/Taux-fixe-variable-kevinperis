# --- Externes (tous optionnels : l'app fonctionne en mode stub sans eux) ---

# Anthropic (Claude) — utilisé côté serveur pour :
#  1. générer la réponse IA personnalisée (src/lib/ai.ts)
#  2. aller chercher les taux fixe 5 ans / variable actuels via l'outil de
#     recherche web de Claude, mis en cache 12h côté serveur (src/lib/rates.ts)
# Tant que la clé n'est pas branchée, les deux retombent sur un mode local
# (texte générique / pas de chiffre de taux affiché).
ANTHROPIC_API_KEY=
# Optionnel : modèle (défaut: claude-opus-5-5).
ANTHROPIC_MODEL=

# CRM (GoHighLevel) — webhook entrant qui reçoit le lead. Si vide,
# src/lib/crm.ts logue le payload côté serveur au lieu de l'envoyer (pour ne
# jamais polluer un CRM de production par erreur). Pas encore connu pour
# Kevin (nouveau client) — à obtenir de lui avant le déploiement.
CRM_WEBHOOK_URL=

# Pixel Meta de Kevin : « Pixel de Kevin » 1388001303411655 est codé par défaut
# (src/lib/pixel.ts) — cette variable ne sert qu'à le remplacer.
NEXT_PUBLIC_META_PIXEL_ID=
# Meta Conversions API (Lead serveur, dédupliqué avec le pixel via eventId).
# Jeton généré dans Gestionnaire d'événements → Pixel de Kevin → Paramètres →
# « Générer un jeton d'accès ». Sans lui, seul le pixel navigateur envoie le Lead.
META_CAPI_TOKEN=
# Optionnel : code de test (onglet « Tester les événements »).
META_TEST_EVENT_CODE=
# Microsoft Clarity — pas encore connu.
NEXT_PUBLIC_CLARITY_ID=
